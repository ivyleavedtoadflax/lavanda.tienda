---
// The picking day, in the order it happens.
import type { Lang } from '../lib/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const steps = {
  es: [
    ['Llegas a Osset', 'Te enviamos la ubicación exacta al reservar.'],
    ['Paseas los campos', 'Con el agricultor, entre las filas en flor.'],
    ['Recoges a mano', 'Aprendes a cortar la espiga en su punto.'],
    ['Te llevas tu manojo', 'La lavanda que recojas es tuya.'],
  ],
  en: [
    ['You arrive in Osset', 'We send the exact location when you book.'],
    ['Walk the fields', 'With the grower, among the rows in flower.'],
    ['Pick by hand', 'Learn to cut the spike at the right moment.'],
    ['Take home your bunch', 'The lavender you pick is yours.'],
  ],
}[lang];
---

<ol class="steps">
  {steps.map(([h, p]) => (
    <li>
      <h3>{h}</h3>
      <p>{p}</p>
    </li>
  ))}
</ol>

<style>
  .steps {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    counter-reset: s;
    position: relative;
  }

  .steps::before {
    content: "";
    position: absolute;
    top: 1.15rem;
    left: 1.15rem;
    right: 1.15rem;
    height: 2px;
    background: var(--line);
  }

  li {
    position: relative;
    display: grid;
    gap: 0.5rem;
    align-content: start;
    counter-increment: s;
    min-width: 0;
  }

  li::before {
    content: counter(s);
    width: 2.3rem;
    height: 2.3rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--cal);
    border: 2px solid var(--lavanda);
    color: var(--lavanda);
    font-weight: 600;
    position: relative;
  }

  p {
    color: var(--muted);
    font-size: 0.95rem;
  }

  @media (max-width: 820px) {
    .steps {
      grid-template-columns: 1fr 1fr;
    }

    .steps::before {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .steps {
      grid-template-columns: 1fr;
    }
  }
</style>
