---
import { EMAIL, whatsapp, type Lang } from '../lib/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <p class="text-muted">
      &copy; {year} Lavanda de la Serranía &middot; Osset, Andilla (Valencia)
    </p>
    <div class="footer-links">
      <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
      <a href={whatsapp(lang === 'es' ? 'Hola' : 'Hello')} target="_blank" rel="noopener">WhatsApp</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    padding: 2rem 0;
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .footer-inner p {
    margin: 0;
  }

  .footer-links {
    display: flex;
    gap: 1.5rem;
  }

  .footer-links a,
  .footer-links a:visited {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .footer-links a:hover {
    color: var(--color-accent);
  }

  @media (max-width: 768px) {
    .footer-inner {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
