---
import type { Lang } from '../lib/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = {
  es: {
    label: 'Lavanda de la Serranía: campos de lavanda en flor, en filas, bajo las sierras de la Serranía de Valencia',
    light: 'Luz',
    hour: 'Hora del día',
    hours: ['Amanecer', 'Mañana', 'Mediodía', 'Tarde', 'Atardecer'],
  },
  en: {
    label: 'Lavanda de la Serranía: lavender fields in flower, in rows, below the hills of the Serranía in inland Valencia',
    light: 'Light',
    hour: 'Time of day',
    hours: ['Dawn', 'Morning', 'Midday', 'Afternoon', 'Dusk'],
  },
}[lang];
---

<div class="scene" data-hours={JSON.stringify(t.hours)}>
  <canvas role="img" aria-label={t.label}></canvas>
  <label class="light">
    <span>{t.light}</span>
    <input type="range" min="0" max="100" value="78" aria-label={t.hour} />
    <output>{t.hours[3]}</output>
  </label>
</div>

<style>
  .scene {
    position: relative;
    height: clamp(460px, 74vh, 760px);
    max-width: 100%;
    overflow: hidden;
    background: #6b6a93;
  }

  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .light {
    position: absolute;
    right: max(16px, env(safe-area-inset-right, 0px));
    bottom: 16px;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    background: rgba(20, 16, 30, 0.45);
    color: #fff;
    padding: 0.45rem 0.85rem;
    border-radius: 999px;
    font-size: 0.85rem;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  input {
    width: 140px;
    accent-color: #c9b8ff;
  }

  output {
    min-width: 6.5em;
  }

  @media (max-width: 480px) {
    input {
      width: 96px;
    }
  }
</style>

<script src="../scripts/scene.js"></script>
