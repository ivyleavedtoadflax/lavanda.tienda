---
import Base from '../../layouts/Base.astro';
import { langPaths, langOf } from '../../lib/i18n';
import { experience, whatsapp, mailto } from '../../lib/site';

export const getStaticPaths = langPaths;
const lang = langOf(Astro.params.lang);

const t = {
  es: {
    title: 'Jornadas de recolección de lavanda',
    description: 'Ven a recoger lavanda en Osset, Andilla, en la Serranía de Valencia. Reserva por WhatsApp o email.',
    h1: 'Recoge lavanda en la Serranía',
    intro: 'Un día en el campo, entre filas de lavanda en flor, en Osset: una aldea de Andilla en la Serranía, en el interior de Valencia.',
    whatH: 'Qué haréis',
    what: [
      'Paseo por los campos con el agricultor.',
      'Recolección de lavanda a mano.',
      'Te llevas a casa la lavanda que recojas.',
    ],
    whenH: 'Cuándo',
    when: 'Durante la floración, en verano. Escríbenos para conocer las fechas.',
    whereH: 'Dónde',
    where: 'Osset, Andilla (Valencia). Te enviamos la ubicación exacta al reservar.',
    map: 'Ver Osset en el mapa',
    priceH: 'Precio',
    ask: 'A consultar. Pregúntanos por grupos y familias.',
    msg: 'Hola, me interesa una jornada de recolección de lavanda. Fecha: ¿? Personas: ¿?',
    subject: 'Jornada de recolección de lavanda',
    wa: 'Reservar por WhatsApp',
    email: 'Reservar por email',
  },
  en: {
    title: 'Lavender-picking days',
    description: 'Come and pick lavender in Osset, Andilla, in the Serranía of inland Valencia. Book by WhatsApp or email.',
    h1: 'Pick lavender in the Spanish Serranía',
    intro: 'A day out in the fields, among rows of lavender in flower, in Osset: a hamlet of Andilla in la Serranía, inland from Valencia.',
    whatH: 'What you will do',
    what: [
      'Walk the fields with the grower.',
      'Pick lavender by hand.',
      'Take home the lavender you pick.',
    ],
    whenH: 'When',
    when: 'While the lavender flowers, in summer. Message us for dates.',
    whereH: 'Where',
    where: 'Osset, Andilla (Valencia). We send the exact location when you book.',
    map: 'See Osset on the map',
    priceH: 'Price',
    ask: 'Ask us. Groups and families welcome.',
    msg: 'Hello, I am interested in a lavender-picking day. Date: ? People: ?',
    subject: 'Lavender-picking day',
    wa: 'Book on WhatsApp',
    email: 'Book by email',
  },
}[lang];

const mapUrl = 'https://www.openstreetmap.org/search?query=Osset%2C%20Andilla%2C%20Valencia';
---

<Base lang={lang} slug="/experiencias" title={t.title} description={t.description}>
  <section>
    <div class="container--narrow">
      <h1>{t.h1}</h1>
      <p class="lead text-muted mt-2">{t.intro}</p>
      <div class="actions mt-3">
        <a href={whatsapp(t.msg)} target="_blank" rel="noopener" class="btn btn--whatsapp">{t.wa}</a>
        <a href={mailto(t.subject, t.msg)} class="btn btn--outline">{t.email}</a>
      </div>
    </div>
  </section>
  <div class="rows" aria-hidden="true"></div>

  <section class="alt">
    <div class="container grid-2">
      <div class="card">
        <h2>{t.whatH}</h2>
        <ul class="list">
          {t.what.map(item => <li>{item}</li>)}
        </ul>
      </div>
      <div class="card">
        <h2>{t.whenH}</h2>
        <p class="text-muted">{t.when}</p>
        <h2 class="mt-3">{t.priceH}</h2>
        <p class="text-muted">{experience.price ?? t.ask}</p>
      </div>
    </div>
  </section>

  <section>
    <div class="container--narrow">
      <h2>{t.whereH}</h2>
      <p>{t.where}</p>
      <a href={mapUrl} target="_blank" rel="noopener">{t.map} &rarr;</a>
    </div>
  </section>
</Base>

<style>
  .lead {
    font-size: 1.15rem;
  }

  .list {
    padding-left: 1.25rem;
    color: var(--color-text-muted);
  }

  .list li {
    margin-bottom: 0.5rem;
  }
</style>
