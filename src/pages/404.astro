---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
---

<Base lang="es" slug="/" title="Página no encontrada · Page not found" description="Esta página no existe. This page doesn't exist.">
  <section>
    <div class="container--narrow not-found">
      <h1>404</h1>
      <p>Esta página no existe. <span lang="en">This page doesn&rsquo;t exist.</span></p>
      <div class="actions">
        <a href={url('/')} class="btn btn--solid">Inicio</a>
        <a href={url('/en/')} class="btn btn--line" lang="en">Home</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .not-found {
    padding: 6rem 0;
  }

  .not-found h1 {
    font-size: 4rem;
    margin-bottom: 0.5rem;
  }

  .not-found p {
    color: var(--muted);
    margin-bottom: 2rem;
  }

  .not-found .actions {
    justify-content: center;
  }
</style>
